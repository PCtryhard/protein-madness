# model weights and databases never go in git (see MANIFEST.md)
weights/
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.a3m
*.ffindex
*.ffdata

# the real target config is created Saturday; commit it deliberately with -f if wanted
# (the example stays tracked)
configs/target.local.yaml

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

