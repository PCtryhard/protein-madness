# run outputs: structures and sqlite files are large and regenerable.
# hardware_notes.md and report.md are findings, not output -- commit those
# deliberately with `git add -f`.
runs/*/structures/
runs/*/*.db
runs/*/*.db-wal
runs/*/*.db-shm
runs/*/stages.jsonl

# model weights and databases never go in git
weights/
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.a3m
*.ffindex
*.ffdata

# a local target or pipeline override; the committed ones stay tracked
config/pipeline.local.yaml
config/targets/*.local.yaml

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# cluster / job debris
slurm-*.out
*.sbatch.log
.modal/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
